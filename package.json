{
  "name": "create-bard-project",
  "displayName": "Bard Project Language",
  "description": "VS Code extension and CLI for .bard-project language with project scaffolding for React Native, Node.js and MongoDB Atlas.",
  "version": "0.0.1",
  "publisher": "bard-project",
  "repository": {
    "type": "git",
    "url": "https://github.com/Code-BardProject/redactor-vscode-bard-project-language.git"
  },
  "homepage": "https://github.com/Code-BardProject/redactor-vscode-bard-project-language",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "bard-project",
    "code-generator",
    "react-native",
    "nodejs",
    "mongodb-atlas",
    "cli"
  ],
  "license": "MIT",
  "files": [
    "scripts",
    "src",
    "syntaxes",
    "language-configuration.json",
    "package.json",
    "README.md"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:bard-project",
    "onCommand:bard-project.createProject",
    "onCommand:bard-project.generateTargets",
    "onCommand:bard-project.openProjectGuide"
  ],
  "main": "./out/extension.js",
  "bin": {
    "create-bard-project": "./scripts/createBardProject.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "bard-project",
        "aliases": [
          "Bard Project",
          "bard-project"
        ],
        "extensions": [
          ".bard-project"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bard-project",
        "scopeName": "source.bard-project",
        "path": "./syntaxes/bard-project.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "bard-project.createProject",
        "title": "Bard Project: Create Project"
      },
      {
        "command": "bard-project.generateTargets",
        "title": "Bard Project: Generate React Native / Node.js"
      },
      {
        "command": "bard-project.openProjectGuide",
        "title": "Bard Project: Open Project Guide"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "create-bard-project": "node ./scripts/createBardProject.js",
    "generate": "node ./scripts/generateCode.js --all",
    "generate:web": "node ./scripts/generateCode.js --web",
    "generate:android": "node ./scripts/generateCode.js --android",
    "generate:ios": "node ./scripts/generateCode.js --ios",
    "generate:linux": "node ./scripts/generateCode.js --linux",
    "generate:windows": "node ./scripts/generateCode.js --windows",
    "generate:macos": "node ./scripts/generateCode.js --macos",
    "generate:server": "node ./scripts/generateCode.js --server",
    "generate:test": "node ./scripts/generateCode.js --test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-firebase/app": "^24.1.0",
    "@react-native-firebase/auth": "^24.1.0",
    "@react-native-firebase/firestore": "^24.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.17.0",
    "@react-navigation/native": "^7.2.6",
    "@react-navigation/native-stack": "^7.17.0",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.17.0",
    "nodemailer": "^6.9.4",
    "react-hook-form": "^7.78.0",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^3.0.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "^1.27.2",
    "react-native-mmkv": "^4.3.1",
    "react-native-reanimated": "^4.4.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "^15.15.5",
    "react-native-toast-message": "^2.3.3",
    "react-native-vector-icons": "^10.3.0",
    "react-native-video": "^6.19.2",
    "react-native-webview": "^13.16.1",
    "react-redux": "^9.3.0",
    "serve": "^14.2.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.120.0",
    "typescript": "^5.5.0",
    "vscode-test": "^1.6.1"
  }
}
